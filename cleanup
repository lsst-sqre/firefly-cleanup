#!/bin/sh
set -e # No '-o pipefail' under ash (Busybox).

# Set $_TESTING to nonempty to exercise the loop logic without removing
#  anything.  Set $DEBUG to trace execution.

# Do this before turning on '-u'; if these are not set, that's OK; we
#  conditionally set '-x' from $DEBUG or its absence and set _TESTING to
#  a definite value.

if [ -n "${DEBUG}" ]; then
    # Enable verbose output.
    set -x
fi
if [ -n "${_TESTING}" ]; then
    _TESTING=1
else
    _TESTING=0
fi

if [ "${CLEANUP_THRESHOLD}" -gt 0 ] && [ "${CLEANUP_THRESHOLD}" -lt 100 ]; then
    _=1  # No-op
else
    printf "Threshold %s not between 1%% and 99%%!\n" ${CLEANUP_THRESHOLD} 1>&2
    exit 1
fi

# Even Busybox includes 'awk' so it would be weird to find a system without it.
#  I don't think I've ever seen a Unix-ish system without 'cut' or 'rev'
#  either.
#  But if you are making a container from scratch, you need  'awk', 'command',
#  'cut', 'rev', and 'quota' for this script to work.
#
# You need 'awk', 'command', 'cut', and 'rev' to even test the logic.
#
for cmd in awk cut; do
    vcmd=$(command -v ${cmd} || true)  # 'command' is POSIX; 'which' is not.
    if [ -z "${vcmd}" ]; then
        printf "No \"%s\" in PATH=\"%s\"\n" ${cmd} ${PATH} 1>&2
        exit 1
    fi
done
# But plenty of modern systems lack quota
quotacmd=$(command -v quota || true)
if [ -z "${quotacmd}" ]; then 
    printf "No \"quota\" in PATH=\"${PATH}\"\n" ${PATH} 1>&2
    if [ "${_TESTING}" -ne 1 ]; then
        exit 1
    else
        printf "Testing will continue and mock out \"quota\".\n" 1>&2
    fi
    quotacmd=""
fi

# Below here, warn and exit if we find an unbound variable.
set -u

# Helper functions.

# Initialize variables they use.
PCT_BLK_USED=0  # Set in get_quota_pct()
PCT_FIL_USED=0
QUOTA="${quotacmd}"  # Overridden when testing

# # Now the functions.
get_quota_pct () {
    # First line identifies the user.
    # Second line names the columns.
    # After that the lines alternate, but we only have one mountpoint.
    #  Next line names the filesystem.
    #  The one after that has all the values.
    # Hence the very last line contains the values.
    set +e  # Disable exit on failure here.
    quota=$(${QUOTA} -f ${CLEANUP_MOUNTPOINT} | tail -1)
    rc=$?
    set -e
    if [ "${rc}" -ne 0 ]; then
        # Quota didn't work.  Probably that's because no quota is set on
        # the filesystem.
        printf "\"%s\" rc=%d" ${QUOTA} ${rc} 2>&1
        printf "; assuming no quota for \"%s\"\n" "${CLEANUP_MOUNTPOUNT}" 2>&1
        return
    fi
    if [ -z "${quota}" ]; then
        # Nothing to do.
        return
    fi
    # field 1: blocks used
    #       2: blocks allowed
    #       3: blocks grace (not considered)
    #       4: files used
    #       5: files allowed
    #       6: files grace (not considered)
    PCT_BLK_USED=$(printf "%s\n" "${quota}" | \
                       awk '{ print int(100 * $1 / $2)}')
    PCT_FIL_USED=$(printf "%s\n" "${quota}" | \
                       awk '{ print int(100 * $4 / $5)}')
}

_maybe_test_arithmetic () {
    # Test the awk arithmetic; specifically, round-towards zero
    if [ "${_TESTING}" -ne 1 ]; then
        return
    fi
    QUOTA="printf \"9840 10000 10000 6792 10000 10000\n\"" 
    get_quota_pct
    if [ "${PCT_BLK_USED}" -ne 98 ]; then
        printf "Expected 98% blocks used, got %s%%\n" ${PCT_BLK_USED} 1>&2
        exit 1
    fi
    if [ "${PCT_FIL_USED}" -ne 67 ]; then
        printf "Expected 67% files used, got %s%%\n" ${PCT_FIL_USED} 1>&2
        exit 1
    fi
}

times="14d 10d 7d 5d 3d 2d 1d 720m 360m 180m 60m 30m 15m 10m 5m 3m 2m 1m"
lasttime="Initial"
for time in ${times}; do
    unit=$(printf "%s\n" ${time} | rev | cut -c -1)
    num=$(printf "%s\n" ${time} | rev | cut -c 2- | rev)
    # Busybox find doesn't support the time suffixes; mtime and mmin instead.
    if [ "${unit}" = "d" ]; then
        findtime="-mtime +${num}"
    else
        findtime="-mmin +${num}"
    fi
    if [ "${_TESTING}" -eq 1 ]; then
        # Test both failure modes
        
        if [ "${unit}" = "d" ]; then
            # Force PCT_BLK_USED above CLEANUP_THRESHOLD
            PCT_BLK_USED=95
            PCT_FIL_USED=30
            CLEANUP_THRESHOLD=80
        else
            PCT_BLK_USED=30
            PCT_FIL_USED=95
            CLEANUP_THRESHOLD=80
        fi
    else
        get_quota_pct  # Won't really check usage if testing
    fi
    if [ "${PCT_BLK_USED}" -lt "${CLEANUP_THRESHOLD}" ]; then
        if [ "${PCT_FIL_USED}" -lt "${CLEANUP_THRESHOLD}" ]; then
            # Success!
            exit 0
        fi
        printf "%s file usage at %s%% > %s%%\n" ${lasttime} ${PCT_FIL_USED} \
               ${CLEANUP_THRESHOLD} 2>&1
    else
        printf "%s block usage at %s%% > %s%%\n" ${lasttime} ${PCT_BLK_USED} \
               ${CLEANUP_THRESHOLD} 2>&1
    fi
        
    # These are strings so we can print them if we're testing,
    #  and execute them if we are not.
    # Busybox 'find' and 'xargs' support -print0
    # 'grep' is trickier, but GNU 'grep' and MacOS 'grep' support both -z
    # and --null (-Z means different things).  Busybox doesn't, so we install
    # GNU 'grep' in the container.
    genfindcmd="find ${CLEANUP_MOUNTPOINT} -print0"
    findfilecmd="${genfindcmd} -type f ${findtime}"
    finddircmd="${genfindcmd} -type d -empty"
    genrmcmd="xargs -0 -r"
    rmfilecmd="${genrmcmd} rm -f"
    rmdircmd="${genrmcmd} rmdir"
    topregex=$(printf "^%s$" "${CLEANUP_MOUNTPOINT}")
    avoidtop="grep -v -z --null ${topregex}"
    
    if [ "${_TESTING}" -eq 1 ]; then  # Don't really run the find/rm
        printf "%s | %s | %s\n" "${findfilecmd}" "${avoidtop}" "${rmfilecmd}" \
               1>&2
    else  # Do run them.
        ${findfilecmd} | ${avoidtop} | ${rmfilecmd}
        ${finddircmd} | ${avoidtop} | ${rmdircmd}
    fi
    lasttime="${time}"
done

# We ran out of stuff to remove.  Fail unless we are testing.
printf "Failed to clean %s" "${CLEANUP_MOUNTPOINT}" 1>&2
printf " below %s%%" "${CLEANUP_THRESHOLD}" 1>&2
printf " after files older than %s removed.\n" "${lasttime}" 1>&2
printf "Final block usage: %s%%;" "${PCT_BLK_USED}" 1>&2
printf " final file usage: %s%%.\n" "${PCT_FIL_USED}" 1>&2
if [ "${_TESTING}" -eq 0 ]; then
   exit 1
fi
