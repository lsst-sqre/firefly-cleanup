# Source this for a testing environment in the container.
# It will replace /usr/bin/quota with a mock.
# Note that it will remove everything in /tmp older than 1 minute, so consider
#  whether anyone is using /tmp before running `cleanup` after sourcing it.

CLEANUP_MOUNTPOINT=/tmp
CLEANUP_THRESHOLD=5
DEBUG=1

export CLEANUP_MOUNTPOINT CLEANUP_THRESHOLD DEBUG

if [ -x /usr/bin/quota ] && ! [ -e /usr/bin/quota.real ]; then
   mv /usr/bin/quota /usr/bin/quota.real
fi
printf "#!/bin/sh\nprintf \"55 100 100 44 100 100\"" > /usr/bin/quota
chmod 0755 /usr/bin/quota
