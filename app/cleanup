#!/bin/sh
# This script is used to clean up quotaed filesystems by deleting the oldest
#  file first and iterating until the usage is less than the specified
#  threshold percentage.  It must run as a user with privilege to remove
#  files and directories from that filesystem, and it uses the quota of the
#  user it is running as.

# Its primary intended use case is to manage the Firefly shared workarea,
#  which keeps overrunning its quota on data-int.lsst.cloud.

# Variable convention: variables local to functions (or mainstream script)
#  are lowercase.  Anything used inside a function that comes from elsewhere
#  is UPPERCASE.  The choice to stay (almost) POSIX and avoid bash-isms is
#  intentional.

# $CLEANUP_THRESHOLD and $CLEANUP_MOUNTPOINT must be set before execution.
#
# $CLEANUP_THRESHOLD specifies the integer percentage at or above which this
#  script will attempt to remove files.  It must be between 1 and 99
#  inclusive.  The percentage applies to both block and file quotas, but
#  the only place I've ever seen files run out before blocks is in mail
#  directories.
# $CLEANUP_MOUNTPOINT specifies where the filesystem to be cleaned is
#  mounted.

# Set $_TESTING to nonempty to exercise the loop logic without removing
#  anything.  Set $DEBUG to trace execution.

# This script exits with return code 0 on success, 1 for incorrect setup,
#  and 2 for failure to clean the requested directory.
#
# Return code 1 covers a missing or non-numeric $CLEANUP_THRESHOLD, a
#  missing $CLEANUP_MOUNTPOINT or one that is not a directory, a missing
#  required command, and any failure to read the quota.  We treat an
#  unreadable quota as a setup failure rather than exiting 0, because
#  without a usage figure we cannot tell whether we are over threshold, and
#  a silent "success" that cleaned nothing would let the filesystem fill up.

# This is the one place we are not POSIX-compliant: pipefail is not POSIX.
# In any event we want to exit on error.
#
# 'set' is a special builtin, so an unsupported '-o' option is a FATAL shell
#  error rather than a failed command: "set -eo pipefail || set -e" does not
#  fall back, it aborts the script on any shell without pipefail (bash
#  happens to survive it, which hides the problem in local testing).  Probe
#  for the option in a subshell, where the failure is contained, and only
#  then set it for real.
set -e
if ( set -o pipefail ) 2>/dev/null; then
    set -o pipefail
fi

# Do this before turning on '-u'; if these are not set, that's OK; we
#  conditionally set '-x' from $DEBUG or its absence and set _TESTING to
#  a definite value.
if [ -n "${DEBUG}" ]; then
    # Enable verbose output.
    set -x
fi
if [ -n "${_TESTING}" ]; then
    _TESTING=1
else
    _TESTING=0
fi

if [ "${CLEANUP_THRESHOLD}" -gt 0 ] && [ "${CLEANUP_THRESHOLD}" -lt 100 ]; then
    # Done in reverse to also fail correctly with a useful message if
    # $CLEANUP_THRESHOLD isn't numeric.
    :  # No-op
else
    printf "Threshold %s not between 1%% and 99%%!\n" "${CLEANUP_THRESHOLD}" 1>&2
    exit 1
fi

# Validate the mountpoint too.  Without this it fell through to 'set -u'
#  inside the loop and exited 2 -- the "failed to clean" code -- after
#  already running quota against an empty path, so a typo in the
#  configuration was indistinguishable from a filesystem we could not clean.
if [ -z "${CLEANUP_MOUNTPOINT:-}" ]; then
    printf "CLEANUP_MOUNTPOINT is not set!\n" 1>&2
    exit 1
fi
if [ ! -d "${CLEANUP_MOUNTPOINT}" ]; then
    printf "CLEANUP_MOUNTPOINT \"%s\" is not a directory!\n" \
           "${CLEANUP_MOUNTPOINT}" 1>&2
    exit 1
fi

# Get our functions.
# 'dirname $0' finds the symlink's directory, not the real one, so a script
#  reached through a symlink (e.g. /usr/local/bin/cleanup -> /app/cleanup,
#  a normal way to install a cron job) would fail to find its functions.
#  'readlink' isn't POSIX, so use it only if it's there and fall back to the
#  unresolved path otherwise.
here=$(dirname "$0")
if command -v readlink > /dev/null 2>&1; then
    real=$(readlink -f "$0" 2>/dev/null || true)
    if [ -n "${real}" ]; then
        here=$(dirname "${real}")
    fi
fi
. "${here}/cleanup-fns.sh"

# All of 'awk', 'command', 'dirname', 'find', 'grep', 'tail', and 'xargs'
#  are POSIX Mandatory, so they ought to be on any general-purpose
#  Unix-like system.
#
# 'readlink' is not POSIX, so it is used only if present (see above).
#
# If you are making a container from scratch you will need all of the
#  above, plus 'quota' and whatever is necessary to mount and work with
#  NFS filesystems in the first place.
#
# You do not need 'quota' to test the logic; it is mocked out for the
#  test functions.
#
# 'awk' and 'tail' are needed even when testing, because test_arithmetic
#  exercises the quota parsing.
for cmd in awk tail; do
    vcmd=$(command -v "${cmd}" || true)  # 'command' is POSIX; 'which' is not.
    if [ -z "${vcmd}" ]; then
        printf "No \"%s\" in PATH=\"%s\"\n" "${cmd}" "${PATH}" 1>&2
        exit 1
    fi
done
# When testing, we never run the actual pipeline, nor do we use quota.
if [ "${_TESTING}" -eq 0 ]; then
    for cmd in find grep quota xargs; do
        vcmd=$(command -v "${cmd}" || true)
        if [ -z "${vcmd}" ]; then
            printf "No \"%s\" in PATH=\"%s\"\n" "${cmd}" "${PATH}" 1>&2
            exit 1
        fi
        if [ "${cmd}" = "quota" ]; then
            QUOTA="${vcmd}"
        fi
    done
else
    QUOTA=""  # Mocked out during testing.
fi

# Below here, warn and exit if we find an unbound variable.
set -u

times="14d 10d 7d 3d 1d 720m 180m 60m 30m 15m 10m 5m 3m 2m 1m"
lasttime="Initial"
if [ "${_TESTING}" -eq 1 ]; then
    test_arithmetic  # Does nothing if not testing.
fi
for time in ${times}; do
    # Split "720m" into num=720 and UNIT=m using POSIX parameter expansion.
    #  This used to shell out to 'rev | cut', which needed 'rev' -- the one
    #  non-POSIX command in the script -- and never checked it was present.
    #  '${time%?}' drops the last character; '${time#"${time%?}"}' keeps it.
    num=${time%?}
    UNIT=${time#"${num}"}
    if [ "${UNIT}" = "m" ]; then
        findtime="-mmin +${num}"
    else
        findtime="-mtime +${num}"
    fi
    if [ "${_TESTING}" -eq 1 ]; then
        test_failure
    else
        # If we cannot read the quota we do not know whether we are over
        #  threshold.  Carrying on would either delete against stale figures
        #  or "succeed" without cleaning anything; both are worse than
        #  failing loudly, so exit 1 (setup/environment problem).
        if ! get_quota_pct; then
            exit 1
        fi
    fi
    if [ "${PCT_BLK_USED}" -lt "${CLEANUP_THRESHOLD}" ]; then
        if [ "${PCT_FIL_USED}" -lt "${CLEANUP_THRESHOLD}" ]; then
            # Success!
            exit 0
        fi
        printf "%s file usage at %s%% > %s%%\n" "${lasttime}" \
               "${PCT_FIL_USED}" "${CLEANUP_THRESHOLD}" 1>&2
    else
        printf "%s block usage at %s%% > %s%%\n" "${lasttime}" \
               "${PCT_BLK_USED}" "${CLEANUP_THRESHOLD}" 1>&2
    fi
        
    # In GNU 'grep', '-z' is the short form of '--null-data' (NUL-separated
    #  input, which is what we need here); '-Z' is '--null'.
    #
    # '-print0' is an action, not a flag, and 'find' evaluates the expression
    #  left to right.  It MUST come after the filters: placed before them it
    #  is always true and prints every path, so the age test never applies
    #  and directories reach 'rm'.
    #
    # We match the mountpoint as a fixed string ('-F') against the whole line
    #  ('-x') rather than building a regex.  The mountpoint is data, not a
    #  pattern: a '*' in the path used to stop the exclusion matching (so an
    #  empty mountpoint was handed to 'rmdir' and removed), a '[' made grep
    #  fail with "Unmatched [", and a '.' matched sibling paths it should not.
    #
    # Everything below runs the commands directly with quoted variables
    #  rather than assembling them into strings and letting the shell re-split
    #  those: a $CLEANUP_MOUNTPOINT containing a space used to become two
    #  arguments, and nothing was cleaned at all.  ${findtime} is deliberately
    #  left unquoted, since it is two words ("-mtime +14").
    if [ "${_TESTING}" -eq 1 ]; then  # Don't really run the find/rm
        # Report what we would have run.  Quoted so the mountpoint reads
        #  unambiguously when it contains spaces.
        printf "find \"%s\" -type f %s -print0" \
               "${CLEANUP_MOUNTPOINT}" "${findtime}" 1>&2
        printf " | ( grep -v -z -F -x \"%s\" || true )" \
               "${CLEANUP_MOUNTPOINT}" 1>&2
        printf " | xargs -0 -r rm -f\n" 1>&2
        printf "find \"%s\" -type d -empty -print0" \
               "${CLEANUP_MOUNTPOINT}" 1>&2
        printf " | ( grep -v -z -F -x \"%s\" || true )" \
               "${CLEANUP_MOUNTPOINT}" 1>&2
        printf " | xargs -0 -r rmdir\n" 1>&2
    else  # Do run them.
        # 'find' exits nonzero if it cannot read any subdirectory, which is
        #  routine in a shared multi-user workarea.  With pipefail and -e
        #  that would abort the whole run, skipping the remaining rungs of
        #  the ladder and the final report, so tolerate it explicitly: we
        #  still delete everything we *could* see.  'rm'/'rmdir' failures
        #  are tolerated for the same reason (a file may vanish underneath
        #  us, or belong to someone else).
        { find "${CLEANUP_MOUNTPOINT}" -type f ${findtime} -print0 \
              || true ; } \
            | ( grep -v -z -F -x "${CLEANUP_MOUNTPOINT}" || true ) \
            | { xargs -0 -r rm -f || true ; }
        { find "${CLEANUP_MOUNTPOINT}" -type d -empty -print0 \
              || true ; } \
            | ( grep -v -z -F -x "${CLEANUP_MOUNTPOINT}" || true ) \
            | { xargs -0 -r rmdir || true ; }
    fi
    lasttime="${time}"
done

# We ran out of stuff to remove.
# Report failure.
printf "Failed to clean %s" "${CLEANUP_MOUNTPOINT}" 1>&2
printf " below %s%%" "${CLEANUP_THRESHOLD}" 1>&2
printf " after files older than %s removed.\n" "${lasttime}" 1>&2
printf "Final block usage: %s%%;" "${PCT_BLK_USED}" 1>&2
printf " final file usage: %s%%.\n" "${PCT_FIL_USED}" 1>&2
# Fail unless testing.
if [ "${_TESTING}" -eq 0 ]; then
   exit 2
fi
